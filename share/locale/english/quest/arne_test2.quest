		state fighting begin
			when enter begin
				q.start()
				q.set_title(gameforge.arne_test2._340_sayTitle)
				send_letter(gameforge.arne_test2._330_sendLetter)
				mob.spawn(102, 356, 483, 1, 1, 1)
			end
			
			when button or info begin
				say_title(gameforge.arne_test2._340_sayTitle)
				say(gameforge.arne_test2._350_say)
			end
			
			when 102.kill begin
				q.done()
				set_state(robbing)
			end

		end
		
	state robbing begin
			when enter begin
				q.start()
				q.set_title(gameforge.arne_test2._360_sendLetter)
				send_letter(gameforge.arne_test2._360_sendLetter)
				local v=find_npc_by_vnum(20095) -- Seon-Hae
				if 0==v then
					else
						target.vid("__TARGET2__", v, gameforge.arne_test2._700_target)
				end
			end
			
			when button or info begin
				say_title(gameforge.arne_test2._370_sayTitle)
				say(gameforge.arne_test2._380_say)
			end	
			
			when __TARGET2__.target.click begin
					target.delete("__TARGET2__")
					say_title(gameforge.arne_test2._390_sayTitle)
					say(gameforge.arne_test2._400_say) -- white font text
					wait()
					say(gameforge.arne_test2._410_say)
					say_reward(gameforge.arne_test2._690_sayReward)
					say_item_vnum(11)
					say(gameforge.arne_test2._420_say)
					q.done()
					pc.change_money(10000)
					pc.give_item2(11, 1)
					pc.give_exp2(100)
			end				
		end	

		
