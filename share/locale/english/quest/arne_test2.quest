	state teleport begin
		when enter or login begin
			if pc.get_map_index() >= 1120000 and pc.get_map_index() <= 1129999 then
				say_in_map("proper state")
				set_state(arena_relocate)
			else
			notice(gameforge.arne_test2._100_notice)
			command("private 112")
			set_state(arena_relocate)
			end
		end
	end
		
		state arena_relocate begin
			when enter or login begin
				if pc.get_map_index() >= 1120000 then
				notice(gameforge.arne_test2._110_notice)
				command("go 88 88")
--				say_in_map("proper state")
				set_state(spawn_arena)
				end
			end
		end
		
		state spawn_arena begin
			when enter or login begin
				mob.spawn(101, 101, 101, 1,1, 3)
				notice(gameforge.arne_test2._120_notice)
				set_state(arena_combat)
			end
		end
		
	
		
		state arena_combat begin
			when enter or login begin
				notice(gameforge.arne_test2._130_notice)
--				if pc.is_dead()	== true then
--					set_state(return_from_arena)
--				end
			end
		
			when 101.kill begin
				local index = pc.getqf("killcount")+1
				pc.setqf("killcount", index)    

				if pc.getqf("killcount") >= 3 then
					notice(gameforge.arne_test2._140_notice)
					set_state(return_from_arena)
				end
			end
		end
		
		state return_from_arena begin
			when enter or login begin
				local CordX = pc.getqf("pcx")*100
				local CordY = pc.getqf("pcy")*100
				pc.setqf("killcount", 0)  
				say_title(gameforge.arne_test2._150_sayTitle)
				say(gameforge.arne_test2._160_say)
				local s = select(gameforge.arne_test2._170_select)
				if s == 1 then
					pc.warp(CordX, CordY)
					notice(gameforge.arne_test2._180_notice)
					set_state(talk_seon)
				end
			end
		end
		
		state hunting begin
			when enter begin	
				q.start()
				q.set_title(gameforge.arne_test2._660_qSetTitle)
				notice(gameforge.arne_test2._190_notice)
				send_letter(gameforge.arne_test2._200_sendLetter)
				q.set_counter(gameforge.arne_test2._650_qSetCounter, HuntAmount)
			end
			
			when button or info begin
				say_title(gameforge.arne_test2._210_sayTitle)
				say(string.format(gameforge.arne_test2._480_say, HuntAmount))
			end
			
			
			-----Kill 171#Hungringer wildhund-----
			when 171.kill begin
				if pc.getqf("kill_count_1") < HuntAmount then
					local index =pc.getqf("kill_count_1") + 1
					pc.setqf("kill_count_1",index)
					q.set_counter_value(HuntAmount - pc.getqf("kill_count_1"))  
					if HuntAmount == pc.getqf("kill_count_1") then
						q.done()
						notice(gameforge.arne_test2._220_notice)
						set_state(back_to_npc)
					end
				end
			end
		end
			
			state back_to_npc begin
				when enter begin
					q.start()
					q.set_title(gameforge.arne_test2._240_sayTitle)
					send_letter(gameforge.arne_test2._230_sendLetter)
					local v=find_npc_by_vnum(20095) -- Seon-Hae
					if 0==v then
					else
						target.vid("__TARGET2__", v, gameforge.arne_test2._700_target)
					end
				end
				
				when button or info begin
					say_title(gameforge.arne_test2._240_sayTitle)
					say(gameforge.arne_test2._250_say)
				end
				
				when __TARGET2__.target.click begin
					target.delete("__TARGET2__")
						say(gameforge.arne_test2._260_say) -- white font text
						wait()
						say(gameforge.arne_test2._270_say)
						say_reward(gameforge.arne_test2._680_sayReward)
						say(gameforge.arne_test2._280_say)
						q.done()
						pc.change_money(10000)
						pc.give_exp2(500)
				end
			end
			
		state gather begin
		
			when enter begin
				q.start()
				q.set_title(gameforge.arne_test2._670_qSetTitle)
				notice(gameforge.arne_test2._290_notice)
				send_letter(gameforge.arne_test2._300_sendLetter)
				q.set_counter(gameforge.arne_test2._650_qSetCounter, GatherAmount)
			end

				when button or info begin
					say_title(gameforge.arne_test2._310_sayTitle)
					say(string.format(gameforge.arne_test2._490_say, GatherAmount))
				end
											
			when 101.kill begin -- yy unfinished yy
				if pc.count_item(50702)< GatherAmount - pc.getqf("collect_count") then
					pc.give_item2(50702, 1)
					local index = pc.getqf("collect_count") + 1
					q.set_counter_value(GatherAmount - pc.getqf("collect_count"))
					pc.setqf("collect_count",index)
					notice(gameforge.arne_test2._320_notice)
					else
					q.done()
--					set_state(return_flowers)
				end			
			end		
		end
		
