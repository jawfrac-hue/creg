quest collect_quest_reset begin
	state start begin
		when login with pc.level >= 92 begin
			if tostring(get_quest_state("collect_quest_lv92")) == "557528158" or
				tostring(get_quest_state("collect_quest_lv94")) == "557528158" or 
				tostring(get_quest_state("collect_quest_lv96")) == "557528158" then
				set_state( check_reset_able )
			end
		end
	end

	state check_reset_able begin
		when 20091.chat.gameforge.collect_quest_reset._420_npcChat begin
			---                                                   l
			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._020_say)
			say(gameforge.collect_quest_reset._030_say)
			say("")

			wait()

			if get_time() < pc.getqf("duration") then
				say(gameforge.collect_quest_reset._010_say)
				say(gameforge.collect_quest_reset._040_say)
				say(gameforge.collect_quest_reset._050_say)
				say(gameforge.collect_quest_reset._060_say)
				return
			end
			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._070_say)
			say(gameforge.collect_quest_reset._080_say)
			say(gameforge.collect_quest_reset._090_say)
			say(gameforge.collect_quest_reset._100_say)
			say(gameforge.collect_quest_reset._110_say)
			say("")

			wait()

			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._120_say)
			say(gameforge.collect_quest_reset._130_say)
			say(gameforge.collect_quest_reset._140_say)
			say(gameforge.collect_quest_reset._150_say)
			say("")

			local s = select(gameforge.collect_quest_reset._160_select, gameforge.collect_quest_reset._170_select)

			if s == 1 then
				say(gameforge.collect_quest_reset._010_say)
				say(gameforge.collect_quest_reset._180_say)
				say("")

				set_state( find_jewel )
			else
				say(gameforge.collect_quest_reset._010_say)
				say(gameforge.collect_quest_reset._190_say)
				say("")
			end
		end
	end

	state find_jewel begin
		when letter begin
			send_letter(gameforge.collect_quest_reset._200_sendLetter)
		end

		when button or info begin
			say("")
			say(gameforge.collect_quest_reset._210_say)
			say(gameforge.collect_quest_reset._220_say)
			say("")

			say_item_vnum( 30254 )

			say_reward(string.format(gameforge.collect_quest_reset._430_sayReward, pc.getqf("collect_count")))
			say("")
		end

		when 2401.kill or 2402.kill or 2403.kill or 2404.kill begin
			if number(1, 500) <= 3 then
				pc.give_item2(30254, 1)
				send_letter(gameforge.collect_quest_reset._230_sendLetter)
			end
		end

		when 2411.kill or 2412.kill or 2413.kill or 2414.kill begin
			if number(1, 500) <= 5 then
				pc.give_item2(30254, 1)
				send_letter(gameforge.collect_quest_reset._230_sendLetter)
			end
		end

		when 20091.chat.gameforge.collect_quest_reset._440_npcChat with pc.count_item(30254) > 0 begin
			pc.remove_item( 30254 , 1 )

			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._240_say)

			setdelay(150)
			say(gameforge.collect_quest_reset._250_say)
			resetdelay()

			if number(1, 100) <= 20 then
				say(gameforge.collect_quest_reset._260_say)
				say(gameforge.collect_quest_reset._270_say)
				say("")
				return
			end

			say(gameforge.collect_quest_reset._280_say)
			say("")

			wait()

			local count = pc.getqf( "collect_count" ) + 1

			if count < 5 then
				pc.setqf( "collect_count", count )

				say(gameforge.collect_quest_reset._010_say)
				say(string.format(gameforge.collect_quest_reset._450_say, 5-count))
				say(gameforge.collect_quest_reset._290_say)
				say("")
				return
			end
			
			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._300_say)
			say("")

			local selTab = {}
			local pos = 1 

			if tostring(get_quest_state("collect_quest_lv92")) == "557528158" then
				table.insert(selTab, pos, gameforge.collect_quest_reset._460_select)
				pos = pos + 1
			end

			if tostring(get_quest_state("collect_quest_lv94")) == "557528158" then
				table.insert(selTab, pos, gameforge.collect_quest_reset._470_select)
				pos = pos + 1
			end

			if tostring(get_quest_state("collect_quest_lv96")) == "557528158" then
				table.insert(selTab, pos, gameforge.collect_quest_reset._480_select)
				pos = pos + 1
			end

			local s = select_table( selTab )

			if selTab[s] == gameforge.collect_quest_reset._460_select then
				affect.remove_collect(1, 1000)
				affect.remove_collect(apply.DEF_GRADE_BONUS, 120)
				affect.remove_collect(apply.ATT_GRADE_BONUS, 51)

				s = select(gameforge.collect_quest_reset._310_select, gameforge.collect_quest_reset._320_select, gameforge.collect_quest_reset._330_select)

				if s == 1 then
					affect.add_collect(1, 1000, 60*60*24*365*60)
					pc.setf("collect_quest_lv92","reward","1")
				elseif s == 2 then
					affect.add_collect(apply.DEF_GRADE_BONUS, 120, 60*60*24*365*60)
					pc.setf("collect_quest_lv92","reward","2")
				elseif s == 3 then
					affect.add_collect(apply.ATT_GRADE_BONUS, 51, 60*60*24*365*60)
					pc.setf("collect_quest_lv92","reward","3")
				end
			elseif selTab[s] == gameforge.collect_quest_reset._470_select then
				affect.remove_collect(1, 1100)
				affect.remove_collect(apply.DEF_GRADE_BONUS, 140)
				affect.remove_collect(apply.ATT_GRADE_BONUS, 60)

				s = select(gameforge.collect_quest_reset._340_select, gameforge.collect_quest_reset._350_select, gameforge.collect_quest_reset._360_select)

				if s == 1 then
					affect.add_collect(1, 1100, 60*60*24*365*60)
					pc.setf("collect_quest_lv94","reward","1")
				elseif s == 2 then
					affect.add_collect(apply.DEF_GRADE_BONUS, 140, 60*60*24*365*60)
					pc.setf("collect_quest_lv94","reward","2")
				elseif s == 3 then
					affect.add_collect(apply.ATT_GRADE_BONUS, 60, 60*60*24*365*60)
					pc.setf("collect_quest_lv94","reward","3")
				end
			elseif selTab[s] == gameforge.collect_quest_reset._480_select then
				affect.remove_collect(1, 2000)
				affect.remove_collect(apply.DEF_GRADE_BONUS, 700)
				affect.remove_collect(apply.ATT_GRADE_BONUS, 300)

				s = select(gameforge.collect_quest_reset._370_select, gameforge.collect_quest_reset._380_select, gameforge.collect_quest_reset._390_select)

				if s == 1 then
					affect.add_collect(1, 2000, 60*60*24*365*60)
					pc.setf("collect_quest_lv96","reward","1")
				elseif s == 2 then
					affect.add_collect(apply.DEF_GRADE_BONUS, 700, 60*60*24*365*60)
					pc.setf("collect_quest_lv96","reward","2")
				elseif s == 3 then
					affect.add_collect(apply.ATT_GRADE_BONUS, 300, 60*60*24*365*60)
					pc.setf("collect_quest_lv96","reward","3")
				end
			end
			pc.setqf( "collect_count", 0 )
			set_state( check_reset_able )

			say(gameforge.collect_quest_reset._010_say)
			say(gameforge.collect_quest_reset._400_say)
			say(gameforge.collect_quest_reset._410_say)
			say("")
			pc.setqf("duration", get_time()+60*60*24*7) 
		end
	end
end

