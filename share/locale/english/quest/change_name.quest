quest chagne_name begin
	state start begin
		when 71055.use begin
			if pc.is_married() then
				say(gameforge.change_name._010_say)
				say("")
				return
			end

			if pc.is_polymorphed() then
				say(gameforge.change_name._020_say)
				say("")
				return
			end

			if pc.has_guild() then
				say(gameforge.change_name._030_say)
				say("")
				return
			end

			if party.is_party() then
				say(gameforge.change_name._040_say)
				say("")
				return
			end

			if pc.get_level() < 35 then
				say(gameforge.change_name._050_say)
				say("")
				return
			end

			if get_time() < pc.getqf("next_time") then
				say(gameforge.change_name._060_say)
				say("")

				if is_test_server() == true then
					say(gameforge.change_name._070_say)
					say("")
				else
					return
				end
			end

			say(gameforge.change_name._080_say) ;

			local name = pc.name ;
			local str = input() ;
			if string.len(str) > 16 then
				say(gameforge.change_name._090_say)
				say("")
				return
				
			end
			local ret = pc.change_name(str) ;

			if ret == 0 then
				say(gameforge.change_name._100_say)
				say(gameforge.change_name._110_say)
				say("")

				char_log(0, "CHANGE_NAME", "HAVE NOT RE-LOGIN")
			elseif ret == 1 then
				say(gameforge.change_name._120_say)
				say(gameforge.change_name._130_say)
				say("")
				
				char_log(0, "CHANGE_NAME", "ITEM USE PROBLEM")
			elseif ret == 2 then
				say(gameforge.change_name._140_say)
				say(gameforge.change_name._150_say)
				say("")

				char_log(0, "CHANGE_NAME", "CAN NOT USE NAME")
			elseif ret == 3 then
				say(gameforge.change_name._140_say)
				say(gameforge.change_name._150_say)
				say("")

				char_log(0, "CHANGE_NAME", "ALREADY USING NAME")
			elseif ret == 4 then
				say(gameforge.change_name._160_say)
				say(gameforge.change_name._170_say)
				say("")

				item.remove() ;

				pc.setqf("next_time", get_time() + time_hour_to_sec(24*15))

				char_log(0, "CHANGE_NAME", "SUCCESS: from "..name.." to "..str)
			else
				say(gameforge.change_name._180_say)
				say("")

				char_log(0, "CHANGE_NAME", "UNKNOWN NAME")
			end
		end
	end
end
