quest manwoo begin
	state start begin
		when 9009.chat.gameforge.manwoo._550_npcChat with pc.get_gm_level() == 5 and game.get_event_flag("manwoo_start") == 0 begin
			say_title(gameforge.manwoo._080_sayTitle)
			say(gameforge.manwoo._090_say) -- Setting which kind of fishes should the fisher man accept in the event
			say(gameforge.manwoo._100_say) -- We have fishes till 27823 but they aren't activated
			
			local fish = input()
			if fish != "" then
				fish = tonumber(fish)
			end
			if fish >= 27802 and fish <= 27818 then -- Check if the input is a number and if it is fishable.
				game.set_event_flag("manwoo_fish", fish) -- To check the fish as an eventflag
			else
				say(gameforge.manwoo._110_say)
				return
			end
			say_title(gameforge.manwoo._080_sayTitle) -- Setting the amount of fishes that would be accepted
			say(gameforge.manwoo._120_say)
			local amount = input()
			if amount != "" then
				amount = tonumber(amount)
			end
			if amount > 0 then
				game.set_event_flag("manwoo", amount)
			else
				say(gameforge.manwoo._130_say)
			end
			
			say_title(gameforge.manwoo._080_sayTitle) -- Setting the reward for the event
			say(gameforge.manwoo._140_say)
			say(gameforge.manwoo._150_say)
			--
			local reward_amount = select(gameforge.manwoo._160_select, gameforge.manwoo._170_select, gameforge.manwoo._180_select, gameforge.manwoo._190_select, gameforge.manwoo._200_select) -- how many different items a player can get, max = 4.
			if s == 5 then
				return
			else
				local i = 0
				repeat
					i = i + 1
					game.set_event_flag("manwoo_reward_"..i, 0)
				until i == 4

				local current_amount = 0
				local again = 1
				repeat -- repeat so that the array will be filled in
					say_title(gameforge.manwoo._080_sayTitle)
					say(string.format(gameforge.manwoo._590_say, current_amount))
					local reward_vnum = input()
					say_title(gameforge.manwoo._080_sayTitle)
					if reward_vnum == "" or reward_vnum == 0 then
						say(gameforge.manwoo._210_say)
						again = select(gameforge.manwoo._220_select, gameforge.manwoo._230_select, gameforge.manwoo._200_select)
						if again == 2 then
							current_amount = reward_amount
						elseif again == 3 then
							return
						end
					else	
						if item_name(reward_vnum) == nil then
							say(gameforge.manwoo._240_say)
							wait()
						else
							say_item_vnum(reward_vnum)
							say("")
							local vnum_ok = select(gameforge.manwoo._250_select, gameforge.manwoo._260_select, gameforge.manwoo._200_select)
							if vnum_ok == 1 then
								current_amount = current_amount + 1
								game.set_event_flag("manwoo_reward_"..current_amount, reward_vnum)
							elseif vnum_ok == 3 then
								return
							end
						end
					end
				until current_amount == reward_amount
				
			end
			
			
			say_title(gameforge.manwoo._080_sayTitle)
			say(gameforge.manwoo._270_say)
			local s = select(gameforge.manwoo._280_select, gameforge.manwoo._290_select, gameforge.manwoo._300_select, gameforge.manwoo._310_select, gameforge.manwoo._320_select, gameforge.manwoo._200_select)
			local hours = 1 -- default value
			if s == 1 then
				hours = 8
			elseif s == 2 then
				hours = 16
			elseif s == 3 then
				hours = 24
			elseif s == 4 then
				hours = 0
			elseif s == 5 then
				hours = tonumber(input())
				if hours < 1 then
					return						
				end
			else
				return
			end
			game.set_event_flag("manwoo_time", get_global_time()+hours*60)
			game.set_event_flag("manwoo_start", 1)
			return
		end
		when 9009.chat.gameforge.manwoo._560_npcChat with pc.get_gm_level() == 5 and game.get_event_flag("manwoo_start") > 0 begin
			say_title(gameforge.manwoo._080_sayTitle)
			local s=select(gameforge.manwoo._330_select, gameforge.manwoo._200_select)
			if s == 1 then
				game.set_event_flag("manwoo_start", 0)
			else
				return
			end
		end
		
		when 9009.chat.gameforge.manwoo._570_npcChat with game.get_event_flag("manwoo_start") > 0 and game.get_event_flag("manwoo_time") >= get_global_time() begin
			pc.setqf("reward", 1) 
			pc.setqf("time", game.get_event_flag("manwoo_time"))
			say_title(gameforge.manwoo._340_sayTitle)
			say(gameforge.manwoo._350_say)
			say(gameforge.manwoo._360_say)
			say(gameforge.manwoo._370_say)
			say(gameforge.manwoo._380_say)
			say(gameforge.manwoo._390_say)
			say(gameforge.manwoo._400_say)
			wait()
			say_title(gameforge.manwoo._340_sayTitle)
			say(gameforge.manwoo._410_say)
			say(gameforge.manwoo._420_say)
			say(gameforge.manwoo._430_say)
			say(gameforge.manwoo._440_say)
			say(gameforge.manwoo._450_say)
			say(gameforge.manwoo._460_say)
			say(gameforge.manwoo._470_say)
			say(string.format(gameforge.manwoo._600_say, game.get_event_flag("manwoo")))
			say_item_vnum(game.get_event_flag("manwoo_fish"))
			wait()
			
			set_state(give_fish)
		end
	end
	
	state give_fish begin
		when login or enter with game.get_event_flag("manwoo_start") == 0 or pc.getqf("time") < get_global_time() begin
			set_state(start)
		end

		when login or enter begin
			say(gameforge.manwoo._480_say)
		end
		
		when 9009.chat.gameforge.manwoo._580_npcChat with game.get_event_flag("manwoo_start") > 0 and game.get_event_flag("manwoo_start") > 0 and game.get_event_flag("manwoo_time") >= get_global_time() begin
			say_title(gameforge.manwoo._340_sayTitle)
			if pc.count_item(game.get_event_flag("manwoo_fish")) < game.get_event_flag("manwoo") then
				say(gameforge.manwoo._490_say)
			else
				say(gameforge.manwoo._500_say)
				say(gameforge.manwoo._510_say)
				say(gameforge.manwoo._520_say)
				wait()
				say_title(gameforge.manwoo._340_sayTitle)
				local current_amount = pc.getqf("reward")
				local reward_vnum = game.get_event_flag("manwoo_reward_"..current_amount)
				if reward_vnum == 0 or reward_vnum == "" then
					local last_item_vnum = 150
					say_item_vnum(last_item_vnum)
					pc.give_item2(last_item_vnum)
				else
					if pc.enough_inventory(reward_vnum) == true then
						say_item_vnum(reward_vnum)
						pc.remove_item(game.get_event_flag("manwoo_fish"), game.get_event_flag("manwoo"))
						pc.give_item2(reward_vnum)
						pc.setqf("reward", current_amount +1)
					else
						say(gameforge.manwoo._530_say)
						say(gameforge.manwoo._540_say)
					end
				end
			end
		end
	end
end