	end
	when 20354.chat.gameforge.xxx_main_quest_mgr._020_npcChat with pc.is_gm() begin
	    set_quest_state("main_quest_lv2", "gototeacher")
	    set_quest_state("main_quest_lv3", "start")
	    set_quest_state("main_quest_lv6", "start")
	end
	when 20354.chat.gameforge.xxx_main_quest_mgr._030_npcChat with pc.is_gm() begin
	    set_quest_state("main_quest_lv3", "gototeacher")
	    set_quest_state("main_quest_lv6", "start")
