quest larbor_day begin
    state start begin
	when 20041.chat.gameforge.xxx_larbor_day._1590_npcChat with pc.is_gm() begin
	    say(string.format(gameforge.xxx_larbor_day._1580_say, game.get_event_flag("larbor_day_quest")))
	end
	when 20041.chat.gameforge.xxx_larbor_day._1600_npcChat with pc.is_gm() and game.get_event_flag("larbor_day_quest")==0 begin
		say(gameforge.xxx_larbor_day._010_say)
		local s=select(gameforge.xxx_larbor_day._020_select, gameforge.xxx_larbor_day._030_select)
		if s==1 then
		    game.set_event_flag("larbor_day_quest", 1)
		end
	end
