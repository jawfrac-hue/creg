quest kids_day_quiz begin
    state start begin
	when 20041.chat.gameforge.xxx_kids_day_quiz._530_npcChat with pc.is_gm() begin
	    local low_value=game.get_event_flag("kids_day_drop")
	    local high_value=game.get_event_flag("kids_day_drop_high")
	    
	    say_title(gameforge.xxx_kids_day_quiz._010_sayTitle)
	    say(string.format(gameforge.xxx_kids_day_quiz._420_say, low_value))
	    say(string.format(gameforge.xxx_kids_day_quiz._430_say, high_value))
	    local s=select(gameforge.xxx_kids_day_quiz._020_select, gameforge.xxx_kids_day_quiz._030_select, gameforge.xxx_kids_day_quiz._040_select)
	    
	    if s==1 then
		say_title(gameforge.xxx_kids_day_quiz._050_sayTitle)
		say("")
		say(string.format(gameforge.xxx_kids_day_quiz._440_say, low_value))
		local v=tonumber(input())
		if v<300 then
		    say(gameforge.xxx_kids_day_quiz._060_say)

		    if not is_test_server() then
		    	return
		    end

		    say(gameforge.xxx_kids_day_quiz._070_say)
		end

		say(string.format(gameforge.xxx_kids_day_quiz._450_say, low_value, v))
		say("")
		local s=select(gameforge.xxx_kids_day_quiz._080_select, gameforge.xxx_kids_day_quiz._090_select)
		if s==1 then
		    say("")	
		    say(gameforge.xxx_kids_day_quiz._100_say)
		    game.set_event_flag("kids_day_drop", v)
		else
		    say("")
		    say(gameforge.xxx_kids_day_quiz._110_say)
		end
	    
	    elseif s==2 then
		say_title(gameforge.xxx_kids_day_quiz._120_sayTitle)
		say(string.format(gameforge.xxx_kids_day_quiz._440_say, high_value))
		local v=tonumber(input())
		if v<300 then
		    say(gameforge.xxx_kids_day_quiz._060_say)

		    if not is_test_server() then
		    	return
		    end

		    say(gameforge.xxx_kids_day_quiz._130_say)
		end

		say(string.format(gameforge.xxx_kids_day_quiz._460_say, high_value, v))
		say("")
		local s=select(gameforge.xxx_kids_day_quiz._140_select, gameforge.xxx_kids_day_quiz._090_select)
		if s==1 then
		    say(gameforge.xxx_kids_day_quiz._100_say)
		    game.set_event_flag("kids_day_drop_high", v)
		else
		    say(gameforge.xxx_kids_day_quiz._110_say)
		end
	    end
	end
	
	when 20041.chat.gameforge.xxx_kids_day_quiz._530_npcChat with pc.is_gm() and game.get_event_flag("kids_day_drop")==0 begin
		say(gameforge.xxx_kids_day_quiz._150_say)
		say("")
		local s=select(gameforge.xxx_kids_day_quiz._160_select, gameforge.xxx_kids_day_quiz._040_select)
		if s==1 then
		    local default_value=1000;
		    game.set_event_flag("kids_day_drop", default_value)
		    game.set_event_flag("kids_day_drop_high", default_value)
		    say(string.format(gameforge.xxx_kids_day_quiz._470_say, default_value))
		end
	end
	
	when 20041.chat.gameforge.xxx_kids_day_quiz._540_npcChat with pc.is_gm() and game.get_event_flag("kids_day_drop")!=0 begin
		say(gameforge.xxx_kids_day_quiz._170_say)
		say("")
		local s=select(gameforge.xxx_kids_day_quiz._180_select, gameforge.xxx_kids_day_quiz._040_select)
		if s==1 then
		    game.set_event_flag("kids_day_drop", 0)
		    game.set_event_flag("kids_day_drop_high", 0)
		end
	end
	
	when 20041.chat.gameforge.xxx_kids_day_quiz._550_npcChat with pc.is_gm() begin
	    say_title(gameforge.xxx_kids_day_quiz._190_sayTitle)
	    say(gameforge.xxx_kids_day_quiz._200_say)
	    say(gameforge.xxx_kids_day_quiz._210_say)

	    local max=table.getn(locale.quiz)
	    say(string.format(gameforge.xxx_kids_day_quiz._480_say, max))

	    local quiz_begin = input()
	    if quiz_begin=="" then
		return
	    end
	    local quiz_end = quiz_begin + 10

	    if quiz_end>max then quiz_end=max end

	    for quiz_index=quiz_begin, quiz_end do
		local quiz_data=locale.quiz[quiz_index]
		say_title(string.format(gameforge.xxx_kids_day_quiz._490_sayTitle, quiz_index))
		say(quiz_data[1])
		say("")
		local s=select(quiz_data[2], quiz_data[3], quiz_data[4], quiz_data[5], gameforge.xxx_kids_day_quiz._560_select)
		if s==5 then
		    return
		elseif s==quiz_data[6] then
		    say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
		    say(gameforge.xxx_kids_day_quiz._230_say)
		    say("")
		    wait()
		else
		    say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
		    say(gameforge.xxx_kids_day_quiz._240_say)
		    say("")
		    say(string.format(gameforge.xxx_kids_day_quiz._500_say, quiz_index))
		    say(quiz_data[1])
		    say_reward(quiz_data[1+quiz_data[6]])
		    say("")
		    wait()
		end
	    end

	end
	
	when 50034.use begin
	    say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
	    say(gameforge.xxx_kids_day_quiz._250_say)
	    say(gameforge.xxx_kids_day_quiz._260_say)
	    say(gameforge.xxx_kids_day_quiz._270_say)
	    say("")
	    say(gameforge.xxx_kids_day_quiz._280_say)
	    say("")
	    local s=select(gameforge.xxx_kids_day_quiz._290_select, gameforge.xxx_kids_day_quiz._300_select)
	    if 2==s then
		return
	    end

	    --pc.remove_item(50034, 1)
	    item.remove()

	    local size=3
	    local chance=pc.getqf("chance")

	    -- Chance benutzen!
	    if 0==chance then
		pc.setqf("chance", number(3, 5))
	    elseif pc.getqf("success_count")==chance then
		pc.setqf("success_count", 0)
		pc.setqf("chance", number(3, 5))
		size=5
	    end

	    say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)

	    if size==5 then
		say(string.format(gameforge.xxx_kids_day_quiz._510_say, size))
		say(gameforge.xxx_kids_day_quiz._310_say)
		say(gameforge.xxx_kids_day_quiz._320_say)
		say("")
		say(gameforge.xxx_kids_day_quiz._330_say)
		say("")
	    else
		say(string.format(gameforge.xxx_kids_day_quiz._520_say, size))
		say(gameforge.xxx_kids_day_quiz._340_say)
		say("")
		say(gameforge.xxx_kids_day_quiz._350_say)
		say("")
	    end
	    wait()

	    for i=1, size+1 do

		local quiz_index=number(1, table.getn(locale.quiz))
		local quiz_data=locale.quiz[quiz_index]

		say_title(string.format(gameforge.xxx_kids_day_quiz._490_sayTitle, i))
		say(quiz_data[1])
		say("")
		local s=select(quiz_data[2], quiz_data[3], quiz_data[4], quiz_data[5])
		if s==quiz_data[6] then
		    if i==size then
			say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
			say(gameforge.xxx_kids_day_quiz._360_say)
			say(gameforge.xxx_kids_day_quiz._370_say)
			say("")

			pc.setqf("success_count", pc.getqf("success_count")+1)

			if 5==size then
			    say_item(gameforge.xxx_kids_day_quiz._570_sayItem, 50036, "")
			    say_reward(gameforge.xxx_kids_day_quiz._580_sayReward)
			    say_reward(gameforge.xxx_kids_day_quiz._590_sayReward)
			    pc.give_item2(50036)
			else
			    say_item(gameforge.xxx_kids_day_quiz._600_sayItem, 50035, "")
			    say_reward(gameforge.xxx_kids_day_quiz._610_sayReward)
			    pc.give_item2(50035)
			end
			say("")
			return
		    else
			say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
			say_reward(gameforge.xxx_kids_day_quiz._620_sayReward)
			say(gameforge.xxx_kids_day_quiz._380_say)
			say("")
			wait()
		    end
		else
		    say_title(gameforge.xxx_kids_day_quiz._220_sayTitle)
		    say(gameforge.xxx_kids_day_quiz._390_say)
		    say(gameforge.xxx_kids_day_quiz._400_say)
		    say(gameforge.xxx_kids_day_quiz._410_say)
		    say("")
		    return
		end
	    end

	end
    end
end

