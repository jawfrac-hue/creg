quest notify_shopmeeting begin
	state start begin
		when 9005.chat.gameforge.xxx_notify_shopmeeting._090_npcChat with pc.level<=4 begin
			say(gameforge.xxx_notify_shopmeeting._010_say)
			say(gameforge.xxx_notify_shopmeeting._020_say)
			say(gameforge.xxx_notify_shopmeeting._030_say)
			say(gameforge.xxx_notify_shopmeeting._040_say)
		    local b=select(gameforge.xxx_notify_shopmeeting._050_select, gameforge.xxx_notify_shopmeeting._060_select)
			if 1==b then
				setstate(accept)
	elseif 2==b then
		say(gameforge.xxx_notify_shopmeeting._070_say)
				 ("Nun, das ist keine schwierige Aufgabe, wie wäre es mit 500 Yang?")
				local b=select(gameforge.xxx_notify_shopmeeting._050_select, gameforge.xxx_notify_shopmeeting._080_select)
				if 1==b then
					setstate(accept)
				elseif 2==b then
				else
					say(string.format(gameforge.buy_fishrod._80_say, b))
					end
				else
				 ("UNBEKANNTE TASTE ["..b.."]")
				 end
				 end
				 end
	state accept begin
		when letter begin
			local v=find_npc_by_vnum(9001)
			if 0==v then
			else
				target.vid("target1", v, "")
			end
			local v=find_npc_by_vnum(9002)
			if 0==v then
			else
				target.vid("target2", v, "")
			end
			local v=find_npc_by_vnum(9003)
			if 0==v then
			else
				target.vid("target3", v, "")
			end
		end
		when leave begin
			target.delete("target1")
			target.delete("target2")
			target.delete("target3")
	 
			
