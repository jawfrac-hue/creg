----------------------------------------------------
--COLLECT QUEST_lv85
--METIN2 수집 퀘스트  
----------------------------------------------------
quest collect_quest_lv85  begin
	state start begin
	end
	state run begin
		when login or levelup with pc.level >= 85  begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, gameforge.collect_quest_lv85._010_target)
			end
			send_letter(gameforge.xxx_collect_quest_lv85._010_sendLetter)
		end

		when button or info begin
			say_title(gameforge.xxx_collect_quest_lv85._020_sayTitle)
			say("")
			say(gameforge.xxx_collect_quest_lv85._030_say)
			say(gameforge.xxx_collect_quest_lv85._040_say)
			say(gameforge.xxx_collect_quest_lv85._050_say)
			say("")
		end
		
		when __TARGET__.target.click or	20084.chat.gameforge.collect_quest_lv85._050_npcChat begin
			target.delete("__TARGET__")
			say(gameforge.xxx_collect_quest_lv85._060_say)
			---                                                   l
		    say(gameforge.xxx_collect_quest_lv85._070_say)
			say(gameforge.xxx_collect_quest_lv85._080_say)
			say(gameforge.xxx_collect_quest_lv85._090_say)
			say(gameforge.xxx_collect_quest_lv85._100_say)
		    say(gameforge.xxx_collect_quest_lv85._110_say)
			say(gameforge.xxx_collect_quest_lv85._120_say)
			say(gameforge.xxx_collect_quest_lv85._130_say)
			say(gameforge.xxx_collect_quest_lv85._140_say)
			wait()
			say(gameforge.xxx_collect_quest_lv85._060_say)
			say(gameforge.xxx_collect_quest_lv85._150_say)
			say(gameforge.xxx_collect_quest_lv85._160_say)
			say(gameforge.xxx_collect_quest_lv85._170_say)
			say(gameforge.xxx_collect_quest_lv85._180_say)
			say(gameforge.xxx_collect_quest_lv85._190_say)
			say("")
			wait()
			say(gameforge.xxx_collect_quest_lv85._200_say)
			say(gameforge.xxx_collect_quest_lv85._210_say)
			say(gameforge.xxx_collect_quest_lv85._220_say)
			say(gameforge.xxx_collect_quest_lv85._230_say)
			say(gameforge.xxx_collect_quest_lv85._240_say)
			say(gameforge.xxx_collect_quest_lv85._250_say)
			say(gameforge.xxx_collect_quest_lv85._260_say)
			say("")																																						  
			set_state(go_to_disciple)
			pc.setqf("duration",0)  -- 시도 할수 있는 시간
			pc.setqf("collect_count",0)--이제껏 모은 아이템 수
			pc.setqf("drink_drug",0) --현혹의 물약을 먹으면 1
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv85._270_sendLetter)
			
		end
		when button or info begin
			say_title(gameforge.xxx_collect_quest_lv85._280_sayTitle)
			---                                                   l
			say("")
			say(gameforge.xxx_collect_quest_lv85._290_say)
			say(gameforge.xxx_collect_quest_lv85._300_say)
			say(gameforge.xxx_collect_quest_lv85._310_say)
			say(gameforge.xxx_collect_quest_lv85._320_say)
			say("")
			say_item_vnum(30167) 
			say_reward(gameforge.collect_quest_lv85._105_1_say_reward.." "..pc.getqf("collect_count")..gameforge.collect_quest_lv85._105_2_say_reward)
			say("")
		end
		
		when 71035.use begin --현혹의 물약
			if get_time() < pc.getqf("duration") then
				say(gameforge.xxx_collect_quest_lv85._330_say)
				return
			end
			if pc.getqf("drink_drug")==1 then
				say(gameforge.xxx_collect_quest_lv85._340_say)
				return
			end
			if pc.count_item(30167)==0 then
				say(gameforge.xxx_collect_quest_lv85._060_say)
				say(gameforge.xxx_collect_quest_lv85._350_say)
				say(gameforge.xxx_collect_quest_lv85._360_say)
				say("")
				return
			end

			item.remove()	
			pc.setqf("drink_drug",1)
		end
		when 2311.kill or  2312.kill or  2313.kill or 2314.kill or 2315.kill begin 
			local s = number(1, 200)
			if s == 1  then
				pc.give_item2(30167)
				send_letter(gameforge.xxx_collect_quest_lv85._370_sendLetter)
			end	
		end


		
    	when 20084.chat.gameforge.collect_quest_lv85._140_npcChat with pc.count_item(30167) >0   begin
			if get_time() > pc.getqf("duration") then
				say(gameforge.xxx_collect_quest_lv85._200_say)
				---                                                   l
				say(gameforge.xxx_collect_quest_lv85._380_say)
				say(gameforge.xxx_collect_quest_lv85._390_say)
				say(gameforge.xxx_collect_quest_lv85._400_say)
				say("")
				pc.remove_item(30167, 1)
				if  is_test_server()  then 
					pc.setqf("duration",get_time()+2) 
				else
					pc.setqf("duration",get_time()+60*60*22) -----------------------------------22시간
				end
				wait()
				
				local pass_percent
				if pc.getqf("drink_drug")==0 then
					pass_percent=60
				else		
					pass_percent=95
				end
				
				local s= number(1,100)
				if s<= pass_percent  then
				   if pc.getqf("collect_count")< 39 then     --40개미만 
						local index =pc.getqf("collect_count")+1 
						pc.setqf("collect_count",index)     --하나 구했으니 +1 해준다
						say(gameforge.xxx_collect_quest_lv85._060_say)
						say(gameforge.xxx_collect_quest_lv85._410_say)
						say(string.format(gameforge.collect_quest_lv85._165_say, 40-pc.getqf("collect_count")))
						say(gameforge.xxx_collect_quest_lv85._420_say)
						say("")
						pc.setqf("drink_drug",0)	 --물약 초기화
						return
					end
					say(gameforge.xxx_collect_quest_lv85._060_say)
					say(gameforge.xxx_collect_quest_lv85._430_say)
					say(gameforge.xxx_collect_quest_lv85._440_say)
					say(gameforge.xxx_collect_quest_lv85._450_say)
					say(gameforge.xxx_collect_quest_lv85._460_say)
					say(gameforge.xxx_collect_quest_lv85._470_say)
					say(gameforge.xxx_collect_quest_lv85._480_say)
					say("")
					pc.setqf("collect_count",0)
					pc.setqf("drink_drug",0)	
					pc.setqf("duration",0) 
					set_state(key_item)
					return
				else								
				say(gameforge.xxx_collect_quest_lv85._060_say)
				say(gameforge.xxx_collect_quest_lv85._490_say)
				say(gameforge.xxx_collect_quest_lv85._500_say)
				say(gameforge.xxx_collect_quest_lv85._510_say)
				say(gameforge.xxx_collect_quest_lv85._520_say)
				say("")				   
				pc.setqf("drink_drug",0)	 --물약 초기화
				return
				end
		else
		  say(gameforge.xxx_collect_quest_lv85._060_say)
		  say(gameforge.xxx_collect_quest_lv85._530_say)
		  say(gameforge.xxx_collect_quest_lv85._540_say)
		  say(gameforge.xxx_collect_quest_lv85._550_say)
		  say(gameforge.xxx_collect_quest_lv85._560_say)
		  say("")
		  return
		end

	end
end


	state key_item begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv85._270_sendLetter)
			
			if pc.count_item(30226)>0 then	
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, gameforge.collect_quest_lv85._010_target)
				end
			end

		end
		when button or info begin
			if pc.count_item(30226) >0 then
				say_title(gameforge.xxx_collect_quest_lv85._570_sayTitle)
				say("")
				---                                                   l
				say(gameforge.xxx_collect_quest_lv85._580_say)
				say(gameforge.xxx_collect_quest_lv85._590_say)
				say("")
				return
			end

			say_title(gameforge.xxx_collect_quest_lv85._600_sayTitle)
			say("")
			---                                                   l
			say(gameforge.xxx_collect_quest_lv85._610_say)
			say(gameforge.xxx_collect_quest_lv85._620_say)
			say(gameforge.xxx_collect_quest_lv85._630_say)
			say_item_vnum(30226)
			say(gameforge.xxx_collect_quest_lv85._640_say)
			say(gameforge.xxx_collect_quest_lv85._650_say)
			say("")
		end
		

	
		when 2311.kill or  2312.kill or  2313.kill or 2314.kill or 2315.kill  begin
			
			 local s = number(1, 500)
			if s == 1 and pc.count_item(30226)==0 then
				pc.give_item2(30226)
				send_letter(gameforge.xxx_collect_quest_lv85._660_sendLetter)
			end	
		end


		
		when __TARGET__.target.click  or	20084.chat.gameforge.collect_quest_lv85._255_npcChat with pc.count_item(30226) > 0  begin
		    target.delete("__TARGET__")
			say(gameforge.xxx_collect_quest_lv85._200_say)
			say(gameforge.xxx_collect_quest_lv85._670_say)
			say(gameforge.xxx_collect_quest_lv85._680_say)
			say(gameforge.xxx_collect_quest_lv85._690_say)
			say(gameforge.xxx_collect_quest_lv85._700_say)
			say(gameforge.xxx_collect_quest_lv85._710_say)
			say(gameforge.xxx_collect_quest_lv85._720_say)
			say(gameforge.xxx_collect_quest_lv85._730_say)
			say("")
			pc.remove_item(30226,1)
			set_state(__reward)
		end
		
	end
	
	state __reward begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv85._740_sendLetter)
			
			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, gameforge.collect_quest_lv85._280_target)
			end

		end
		when button or info begin
			say_title(gameforge.xxx_collect_quest_lv85._750_sayTitle)
			---                                                   l
			say(gameforge.xxx_collect_quest_lv85._760_say)
			say(gameforge.xxx_collect_quest_lv85._770_say)
			say(gameforge.xxx_collect_quest_lv85._780_say)
			say(gameforge.xxx_collect_quest_lv85._790_say)
			say(gameforge.xxx_collect_quest_lv85._800_say)
			say("")
		end
		
		when __TARGET__.target.click  or	20018.chat.gameforge.collect_quest_lv85._310_npcChat  begin
		    target.delete("__TARGET__")
			say(gameforge.xxx_collect_quest_lv85._810_say)
			say(gameforge.xxx_collect_quest_lv85._820_say)
			say(gameforge.xxx_collect_quest_lv85._830_say)
			say(gameforge.xxx_collect_quest_lv85._840_say)
			say("")
			wait()
			say(gameforge.xxx_collect_quest_lv85._810_say)
			say(gameforge.xxx_collect_quest_lv85._850_say)
			say(gameforge.xxx_collect_quest_lv85._860_say)
			say("")
			say_reward(gameforge.collect_quest_lv85._317_say_reward)
			say_reward(gameforge.collect_quest_lv85._318_say_reward)
			say_reward(gameforge.collect_quest_lv85._319_say_reward)
			say("")
			pc.give_item2(50115) 
			clear_letter()
			affect.add_collect_point(POINT_RESIST_WARRIOR,10,60*60*24*365*60) --60년	
			affect.add_collect_point(POINT_RESIST_ASSASSIN,10,60*60*24*365*60) --60년	
			affect.add_collect_point(POINT_RESIST_SURA,10,60*60*24*365*60) --60년	
			affect.add_collect_point(POINT_RESIST_SHAMAN,10,60*60*24*365*60) --60년	
			set_quest_state("collect_quest_lv90", "run")
			set_state(__complete)
		end
			
	end

	
	state __complete begin
	end
end


