quest Kaiser begin
	state start begin

		when electionman1.chat.gameforge.xxx_monarch._320_npcChat 	or electionman2.chat.gameforge.xxx_monarch._320_npcChat 	or electionman3.chat.gameforge.xxx_monarch._320_npcChat with pc.is_gm()  begin
	
			if game.get_event_flag("Kaiser") == 1 then 
				say(gameforge.xxx_monarch._010_say)
				say(gameforge.xxx_monarch._020_say)
				local s = select(gameforge.xxx_monarch._030_select, gameforge.xxx_monarch._040_select)

				if s == 1 then
					game.set_event_flag("Kaiser",0)
				end
			else
				say(gameforge.xxx_monarch._050_say)
				say(gameforge.xxx_monarch._060_say)
				local s = select(gameforge.xxx_monarch._070_select, gameforge.xxx_monarch._080_select)

				if s == 1 then
					game.set_event_flag("Kaiser",1)
				end

			end
			
		end
		
		when electionman1.chat.gameforge.xxx_monarch._330_npcChat or  electionman2.chat.gameforge.xxx_monarch._330_npcChat 	or electionman3.chat.gameforge.xxx_monarch._330_npcChat with pc.is_gm()  begin
	
			if game.get_event_flag("Kaiserwahl") == 1 then 
				say(gameforge.xxx_monarch._010_say)
				say(gameforge.xxx_monarch._020_say)
				local s = select(gameforge.xxx_monarch._030_select, gameforge.xxx_monarch._040_select)

				if s == 1 then
					game.set_event_flag("Kaiserwahl",0)
				end
			else
				say(gameforge.xxx_monarch._090_say)
				say(gameforge.xxx_monarch._100_say)
				local s = select(gameforge.xxx_monarch._070_select, gameforge.xxx_monarch._110_select)

				if s == 1 then
					game.set_event_flag("Kaiserwahl",1)
				end

			end
			
		end
	

		when electionman1.chat.gameforge.xxx_monarch._340_npcChat or electionman2.chat.gameforge.xxx_monarch._340_npcChat or electionman3.chat.gameforge.xxx_monarch._340_npcChat  begin
		

			if  game.get_event_flag("Kaiserwahl") != 1 then
				
				
				say(gameforge.xxx_monarch._120_say)
				say(gameforge.xxx_monarch._130_say)
				return 	
			end
			local g = oh.candidacy_list() 
			local gname_table = {}

			table.foreachi(g,
			function(n, p) 
				gname_table[n] = n.."."..oh.candidacy_name(n-1)
			end)

			if table.getn(g) == 0 then
				-- no currently war
				say(gameforge.xxx_monarch._140_say)
			else
				gname_table[table.getn(g)+1] = locale.cancel
				say(gameforge.xxx_monarch._150_say)
				say(gameforge.xxx_monarch._160_say)
				say(gameforge.xxx_monarch._170_say)
				say(gameforge.xxx_monarch._180_say)
				say(gameforge.xxx_monarch._190_say)
				wait()
				local s = select_table(gname_table)

				if s == table.getn(gname_table) then
					return;
				else
					ret = oh.election( s -1 )
					
					say(oh.candidacy_name(s-1)..gameforge.xxx_monarch._390_say)
				end
			end	
		end
		when electionman1.chat.gameforge.xxx_monarch._350_npcChat 	or electionman2.chat.gameforge.xxx_monarch._350_npcChat 	or electionman3.chat.gameforge.xxx_monarch._350_npcChat  begin
	    
			if  game.get_event_flag("Kaiser") != 1 then
				say(gameforge.xxx_monarch._200_say)
				say(gameforge.xxx_monarch._210_say)
				say("")
				say_reward(gameforge.xxx_monarch._360_sayReward)
				say_reward(gameforge.xxx_monarch._370_sayReward)
				say_reward(gameforge.xxx_monarch._380_sayReward)
				
				say("")
				say(gameforge.xxx_monarch._220_say)
				say(gameforge.xxx_monarch._230_say)
				return 	
			end
			say(gameforge.xxx_monarch._240_say)
			say(gameforge.xxx_monarch._250_say)
			say("")
			say_reward(gameforge.xxx_monarch._360_sayReward)
			say_reward(gameforge.xxx_monarch._370_sayReward)
			say_reward(gameforge.xxx_monarch._380_sayReward)

			say("")
			say(gameforge.xxx_monarch._260_say)

		    local s = select(gameforge.xxx_monarch._270_select, gameforge.xxx_monarch._280_select)

			local NEED_MONEY = 100000000

			if s == 1 then
				if oh.candidacycount() >= 8 then
					say(gameforge.xxx_monarch._290_say)
					say(gameforge.xxx_monarch._300_say)
					say(gameforge.xxx_monarch._310_say)
					return 
				end
				if pc.get_gold() >= NEED_MONEY and pc.get_level() >= 50 and oh.isguildmaster() == 1 then 

					pc.change_gold(-NEED_MONEY);
					oh.candidacy();
				end
			end
		end
	end
end
