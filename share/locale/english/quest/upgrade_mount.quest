quest upgrade_mount begin
	state start begin
		when 71115.use with pc.count_item(50156) > 0 begin
			say(gameforge.upgrade_mount._010_say)
			s = select(gameforge.upgrade_mount._020_select, gameforge.upgrade_mount._030_select)
			if s == 2 then
				return
			else
				pc.remove_item(50156,1)
				pc.remove_item(71115,1)
				pc.give_item2(71124, 1)	
			end
				
		end
	end
end
