quest kill_straydog begin
	state start begin
		when 20008.chat.gameforge.xxx_kill_straydog._970_npcChat with number(1, 10)==1 and pc.level>=25 begin
		        ----"12345678901234567890123456789012345678901234567890"|   
                        say_title(gameforge.xxx_kill_straydog._010_sayTitle)
                        say("")
			say(gameforge.xxx_kill_straydog._020_say)
			say(gameforge.xxx_kill_straydog._030_say)
			say(gameforge.xxx_kill_straydog._040_say)
			say(gameforge.xxx_kill_straydog._050_say)
			say(gameforge.xxx_kill_straydog._060_say)
			say(gameforge.xxx_kill_straydog._070_say)
			say(gameforge.xxx_kill_straydog._080_say)
			say(gameforge.xxx_kill_straydog._090_say)
                        say(gameforge.xxx_kill_straydog._100_say)
			local b=select(gameforge.xxx_kill_straydog._110_select, gameforge.xxx_kill_straydog._120_select)
			if 1==b then
				say(gameforge.xxx_kill_straydog._130_say)
				say(gameforge.xxx_kill_straydog._140_say)
				say(gameforge.xxx_kill_straydog._150_say)
			elseif 2==b then
				say(gameforge.xxx_kill_straydog._160_say)
				say(gameforge.xxx_kill_straydog._170_say)
				say(gameforge.xxx_kill_straydog._180_say)
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
	end
	state recv begin
		when login with number(1, 10)==1 and pc.level>=25 and pc.level<=35 begin
			setstate(join)
		end
		when 20008.chat.gameforge.xxx_kill_straydog._980_npcChat begin
			say_title(gameforge.xxx_kill_straydog._010_sayTitle)
                        say("")
			say(gameforge.xxx_kill_straydog._190_say)
			say(gameforge.xxx_kill_straydog._200_say)
			say(gameforge.xxx_kill_straydog._210_say)
		end
	end
	state join begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._990_makeQuestButton)
			q.set_title(gameforge.xxx_kill_straydog._220_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._220_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._230_say)
                        say(gameforge.xxx_kill_straydog._240_say)
			say("")
			say(gameforge.xxx_kill_straydog._250_say)
			say(gameforge.xxx_kill_straydog._260_say)
			say(gameforge.xxx_kill_straydog._270_say)
			say("")
			say(gameforge.xxx_kill_straydog._280_say)
			say("")
			say(gameforge.xxx_kill_straydog._290_say)
			local b=select(gameforge.xxx_kill_straydog._300_select, gameforge.xxx_kill_straydog._310_select, gameforge.xxx_kill_straydog._320_select)
			if 1==b then
				if pc.getqf("best_time")==0 then
					say(gameforge.xxx_kill_straydog._330_say)
				else
					say(gameforge.xxx_kill_straydog._340_say)
					say("")
					say(string.format(gameforge.xxx_kill_straydog._1000_say, math.floor(pc.getqf("best_time")/60)))
					say(string.format(gameforge.xxx_kill_straydog._1010_say, math.floor(pc.getqf("prev_time")/60)))
				end
			elseif 2==b then
				setstate(desc)
			elseif 3==b then
				setstate(start)
				q.done()
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
		when info begin
			say_title(gameforge.xxx_kill_straydog._350_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._360_say)
			say(gameforge.xxx_kill_straydog._240_say)
			say("")
			say(gameforge.xxx_kill_straydog._250_say)
			say(gameforge.xxx_kill_straydog._260_say)
			say(gameforge.xxx_kill_straydog._270_say)
			say("")
			say(gameforge.xxx_kill_straydog._370_say)
			say("")
			say(gameforge.xxx_kill_straydog._290_say)
			say("")
			local b=select(gameforge.xxx_kill_straydog._300_select, gameforge.xxx_kill_straydog._310_select, gameforge.xxx_kill_straydog._320_select)
			if 1==b then
				if pc.getqf("best_time")==0 then
					say(gameforge.xxx_kill_straydog._330_say)
				else
					say_title(gameforge.xxx_kill_straydog._380_sayTitle)
					say("")
					say(string.format(gameforge.xxx_kill_straydog._1000_say, math.floor(pc.getqf("best_time")/60)))
					say(string.format(gameforge.xxx_kill_straydog._1015_say, math.floor(pc.getqf("prev_time")/60)))
				end
			elseif 2==b then
				setstate(desc)
			elseif 3==b then
				setstate(start)
				q.done()
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
	end
	state desc begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._1020_makeQuestButton)
			q.set_title(gameforge.xxx_kill_straydog._390_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._390_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._400_say)
			say(gameforge.xxx_kill_straydog._410_say)
			say(gameforge.xxx_kill_straydog._420_say)
			say(gameforge.xxx_kill_straydog._430_say)
			say("")
			say(gameforge.xxx_kill_straydog._440_say)
			say("")
			say(gameforge.xxx_kill_straydog._450_say)
			say("")
			local b=select(gameforge.xxx_kill_straydog._460_select, gameforge.xxx_kill_straydog._470_select, gameforge.xxx_kill_straydog._480_select)
			if 1==b then
				pc.setqf("life", 2)
				setstate(game)
			elseif 2==b then
			elseif 3==b then
				setstate(start)
				q.done()
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
		when info begin
			say_title(gameforge.xxx_kill_straydog._390_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._400_say)
			say(gameforge.xxx_kill_straydog._410_say)
			say(gameforge.xxx_kill_straydog._490_say)
			say(gameforge.xxx_kill_straydog._430_say)
			say("")
			say(gameforge.xxx_kill_straydog._440_say)
			say("")
			say(gameforge.xxx_kill_straydog._450_say)
			say("")
			local b=select(gameforge.xxx_kill_straydog._460_select, gameforge.xxx_kill_straydog._470_select, gameforge.xxx_kill_straydog._480_select)
			if 1==b then
				pc.setqf("life", 2)
				setstate(game)
			elseif 2==b then
			elseif 3==b then
				setstate(start)
				q.done()
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
	end
	state game begin
		when 101.party_kill begin
			pc.setqf("kill_count", pc.getqf("kill_count")+1)
			q.set_counter(gameforge.xxx_kill_straydog._1030_counter, 1000-pc.getqf("kill_count"))
		end
		when enter begin
			pc.setqf("start_time", get_time())
			pc.setqf("kill_count", 0)
		end
		when leave begin
			q.done()
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._500_sayTitle)
			q.set_title(gameforge.xxx_kill_straydog._500_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._500_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._510_say)
			say(gameforge.xxx_kill_straydog._520_say)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1040_say, pc.getqf("kill_count")))
			say(string.format(gameforge.xxx_kill_straydog._1050_say, math.floor((get_time()-pc.getqf("start_time"))/60)))
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1060_say, pc.getqf("life")))
			local b=select(gameforge.xxx_kill_straydog._530_select, gameforge.xxx_kill_straydog._540_select, gameforge.xxx_kill_straydog._480_select)
			if 1==b then
			elseif 2==b then
				if pc.getqf("life")>0 then
					say(gameforge.xxx_kill_straydog._550_say)
					say(gameforge.xxx_kill_straydog._560_say)
					say("")
					local b=select(gameforge.xxx_kill_straydog._570_select, gameforge.xxx_kill_straydog._580_select)
					if 1==b then
						setstate(game)
						q.done()
					elseif 2==b then
					else
						say(string.format(gameforge.xxx_kill_straydog._960_say, b))
					end
				else
					say(gameforge.xxx_kill_straydog._590_say)
				end
			elseif 3==b then
				say(gameforge.xxx_kill_straydog._600_say)
				say("")
				local b=select(gameforge.xxx_kill_straydog._570_select, gameforge.xxx_kill_straydog._580_select)
				if 1==b then
					setstate(start)
					q.done()
				elseif 2==b then
				else
					say(string.format(gameforge.xxx_kill_straydog._960_say, b))
				end
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
		when info begin
			say_title(gameforge.xxx_kill_straydog._500_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._510_say)
			say(gameforge.xxx_kill_straydog._610_say)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1040_say, pc.getqf("kill_count")))
			say(string.format(gameforge.xxx_kill_straydog._1050_say, math.floor((get_time()-pc.getqf("start_time"))/60)))
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1070_say, pc.getqf("life")))
			say("")
			local b=select(gameforge.xxx_kill_straydog._620_select, gameforge.xxx_kill_straydog._630_select, gameforge.xxx_kill_straydog._640_select)
			if 1==b then
			elseif 2==b then
				if pc.getqf("life")>0 then
					say(gameforge.xxx_kill_straydog._650_say)
					say(gameforge.xxx_kill_straydog._660_say)
					say("")
					local b=select(gameforge.xxx_kill_straydog._570_select, gameforge.xxx_kill_straydog._580_select)
					if 1==b then
						setstate(game)
						q.done()
					elseif 2==b then
					else
						say(string.format(gameforge.xxx_kill_straydog._960_say, b))
					end
				else
					say(gameforge.xxx_kill_straydog._670_say)
				end
			elseif 3==b then
				say(gameforge.xxx_kill_straydog._680_say)
				say("")
				local b=select(gameforge.xxx_kill_straydog._570_select, gameforge.xxx_kill_straydog._580_select)
				if 1==b then
					setstate(start)
					q.done()
				elseif 2==b then
				else
					say(string.format(gameforge.xxx_kill_straydog._960_say, b))
				end
			else
				say(string.format(gameforge.xxx_kill_straydog._960_say, b))
			end
		end
		when 101.party_kill with pc.getqf("kill_count") >= 1000 begin
			pc.setqf("game_time", (get_time()-pc.getqf("start_time")))
			setstate(report)
		end
	end
	state report begin
		when letter begin
			local v=find_npc_by_vnum(20008)
			if 0==v then
			else
				target.vid("__TARGET__", v, "")
			end
		end
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._690_sayTitle)
			q.set_title(gameforge.xxx_kill_straydog._690_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._690_sayTitle)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1080_say, pc.getqf("kill_count")))
			say(gameforge.xxx_kill_straydog._700_say)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1050_say, math.floor(pc.getqf("game_time")/60)))
			say("")
		end
		when info begin
			say_title(gameforge.xxx_kill_straydog._690_sayTitle)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1080_say, pc.getqf("kill_count")))
			say(gameforge.xxx_kill_straydog._700_say)
			say("")
			say(string.format(gameforge.xxx_kill_straydog._1090_say, math.floor(pc.getqf("game_time")/60)))
			say("")
		end
		when __TARGET__.target.click begin
			target.delete("__TARGET__")
			if pc.getqf("kill_count")>=1000 then
				if 30*60>pc.getqf("game_time") then
					say_title(gameforge.xxx_kill_straydog._010_sayTitle)
					say("")
					say(gameforge.xxx_kill_straydog._710_say)
					say(gameforge.xxx_kill_straydog._720_say)
					say(gameforge.xxx_kill_straydog._730_say)
					say(gameforge.xxx_kill_straydog._740_say)
					setstate(reward_1st)
				elseif 40*60>pc.getqf("game_time") then
					say_title(gameforge.xxx_kill_straydog._010_sayTitle)
					say("")
					say(gameforge.xxx_kill_straydog._750_say)
					say(gameforge.xxx_kill_straydog._760_say)
					say(gameforge.xxx_kill_straydog._730_say)
					say(gameforge.xxx_kill_straydog._770_say)
					setstate(reward_2st)
				elseif 50*60>pc.getqf("game_time") then
					say_title(gameforge.xxx_kill_straydog._010_sayTitle)
					say("")
					say(gameforge.xxx_kill_straydog._750_say)
					say(gameforge.xxx_kill_straydog._780_say)
					say(gameforge.xxx_kill_straydog._790_say)
					setstate(reward_3st)
				else
					say_title(gameforge.xxx_kill_straydog._010_sayTitle)
					say("")
					say(gameforge.xxx_kill_straydog._800_say)
					say(gameforge.xxx_kill_straydog._810_say)
					say(gameforge.xxx_kill_straydog._820_say)
					setstate(__COMPLETE__)
					q.done()
				end
			else
				say(gameforge.xxx_kill_straydog._830_say)
			end
		end
	end
	state reward_1st begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._840_sayTitle)
			q.set_title(gameforge.xxx_kill_straydog._840_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._840_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._850_say)
			say(gameforge.xxx_kill_straydog._860_say)
			say(gameforge.xxx_kill_straydog._870_say)
			say(gameforge.xxx_kill_straydog._880_say)
			say(gameforge.xxx_kill_straydog._890_say)
			pc.changemoney(300000)
			setstate(__COMPLETE__)
			q.done()
		end
	end
	state reward_2st begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._900_sayTitle)
			q.set_title(gameforge.xxx_kill_straydog._900_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._900_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._910_say)
			say(gameforge.xxx_kill_straydog._860_say)
			say(gameforge.xxx_kill_straydog._870_say)
			say(gameforge.xxx_kill_straydog._880_say)
			say(gameforge.xxx_kill_straydog._890_say)
			pc.changemoney(100000)
			setstate(__COMPLETE__)
			q.done()
		end
	end
	state reward_3st begin
		when letter begin
			setskin(NOWINDOW)
			makequestbutton(gameforge.xxx_kill_straydog._920_sayTitle)
			q.set_title(gameforge.xxx_kill_straydog._920_sayTitle)
			q.start()
		end
		when button begin
			say_title(gameforge.xxx_kill_straydog._920_sayTitle)
			say("")
			say(gameforge.xxx_kill_straydog._930_say)
			say(gameforge.xxx_kill_straydog._860_say)
			say(gameforge.xxx_kill_straydog._940_say)
			say(gameforge.xxx_kill_straydog._950_say)
			say("")
			pc.changemoney(50000)
			setstate(__COMPLETE__)
			q.done()
		end
	end
	state __COMPLETE__ begin
		when enter begin
			q.done()
		end
	end
end

