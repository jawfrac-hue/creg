quest trash_npc begin
	state start begin
		when 20041.take with game.get_event_flag("trash_npc") == 0 begin -- to close if needed
			say_npc()
			say("" )
			say(gameforge.item_delete._010_say)
			say("" )
			say_show_item(item.vnum)
			say("")
			local s = select(gameforge.locale.yes, gameforge.locale.no)
			if s == 1 then
				item.remove()
			else
				return
			end
		end
	end
end