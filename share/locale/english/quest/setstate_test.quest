quest setstate_test begin
	state start begin
	end
	state hunt begin
		when login begin
			notice(string.format(gameforge.setstate_test._010_notice, pc.getqf("killed")))
		end
		when login or enter begin
			q.set_title(gameforge.setstate_test._020_qSetTitle)
			q.set_counter(gameforge.setstate_test._030_qSetCounter, pc.getqf("killed"))
			q.start()
		end
		
		when 101.kill begin
			local killed = pc.getqf("killed")+1
			notice(string.format(gameforge.setstate_test._040_notice, killed))
			pc.setqf("killed", killed)
			q.set_counter(gameforge.setstate_test._030_qSetCounter, killed)
		end
	end
end