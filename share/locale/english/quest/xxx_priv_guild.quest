quest priv_guild begin
	state start begin
		when guild_man1.chat.gameforge.xxx_priv_guild._080_npcChat or 	guild_man2.chat.gameforge.xxx_priv_guild._080_npcChat or guild_man3.chat.gameforge.xxx_priv_guild._080_npcChat with pc.get_gm_level()== 5 begin

			-- Select guild
			say_title(gameforge.xxx_priv_guild._010_sayTitle)
			say(gameforge.xxx_priv_guild._020_say)

			local g_name = input()
			local g_id = __get_guildid_byname( g_name )
			if 0 == g_id then
				say(gameforge.xxx_priv_guild._090_say)
				return
			end

			-- Select bonus type
			say_title(gameforge.xxx_priv_guild._010_sayTitle)
			say(gameforge.xxx_priv_guild._100_say)
			say( __get_guild_priv_string( g_id ) )
			say(gameforge.xxx_priv_guild._110_say)

			local titles = {
				gameforge.xxx_priv_guild._120_1_select, 
				gameforge.xxx_priv_guild._120_2_select, 
				gameforge.xxx_priv_guild._120_3_select,
				gameforge.xxx_priv_guild._120_4_select,
			}

			local t = select(
				titles[1],
				titles[2],
				titles[3],
				titles[4],
				gameforge.xxx_priv_guild._130_select)

			if t == 5 then
				return
			end

			-- Select the number of bonus
			say_title(gameforge.xxx_priv_guild._010_sayTitle)
			say(string.format(gameforge.xxx_priv_guild._140_say, g_name, titles[t]))
			say('')
			local g = {0,10,20,30,40,50}
			say(gameforge.xxx_priv_guild._150_say)
			local p = select(string.format(gameforge.xxx_priv_guild._160_select, g[1]), string.format(gameforge.xxx_priv_guild._160_select, g[2]), string.format(gameforge.xxx_priv_guild._160_select, g[3]), string.format(gameforge.xxx_priv_guild._160_select, g[4]), string.format(gameforge.xxx_priv_guild._160_select, g[5]), string.format(gameforge.xxx_priv_guild._160_select, g[6]), gameforge.xxx_priv_guild._130_select)
			if p == 7 then
				return
			end

			-- Select bonus time
			say_title(gameforge.xxx_priv_guild._010_sayTitle)
			say(string.format(gameforge.xxx_priv_guild._170_say, g_name, titles[t], g[p]))
			say('')

			say(gameforge.xxx_priv_guild._180_say)
			local v = 0
			local h = select(gameforge.xxx_priv_guild._030_select, gameforge.xxx_priv_guild._040_select, gameforge.xxx_priv_guild._050_select, gameforge.xxx_priv_guild._060_select, gameforge.xxx_priv_guild._070_select)
			if 5 == h then
				return
			elseif 4 == h then

				-- Enter bonus time directly
				say_title(gameforge.xxx_priv_guild._010_sayTitle)
				say(string.format(gameforge.xxx_priv_guild._170_say, g_name, titles[t], g[p]))
				say('')
				say(gameforge.xxx_priv_guild._190_say)
				v= input()

				if v == "" then
					v = 0
				else
					v = tonumber( v )
				end

			elseif 3 == h then
				v=24
			elseif 2 == h then
				v=12
			elseif 1 == h then
				v=6
			end

			-- Confirm setting
			say_title(gameforge.xxx_priv_guild._010_sayTitle)
			say(string.format(gameforge.xxx_priv_guild._200_say, g_name, titles[t], g[p], v))
			say('')
			say(gameforge.xxx_priv_guild._210_say)

			local s = select(gameforge.xxx_priv_guild._220_select, gameforge.xxx_priv_guild._230_select)
			if 1 == s then
				__give_guild_priv(g_id, t, g[p], v*60*60)
				say(gameforge.xxx_priv_guild._240_say)
			else
				say(gameforge.xxx_priv_guild._250_say)
			end
		end
	end
end


