----------------------------------------------------
--COLLECT QUEST_lv90
--METIN2 수집 퀘스트  
----------------------------------------------------
quest collect_quest_lv90  begin
	state start begin
	end
	state run begin
		when login or levelup with pc.level >= 90  begin
			set_state(information)
		end	
	end

	state information begin
		when letter begin
			local v = find_npc_by_vnum(20084)
			if v != 0 then
				target.vid("__TARGET__", v, gameforge.collect_quest_lv90._010_target)
			end
			send_letter(gameforge.xxx_collect_quest_lv90._010_sendLetter)
		end

		when button or info begin
			say("")
			say(gameforge.xxx_collect_quest_lv90._020_say)
			say(gameforge.xxx_collect_quest_lv90._030_say)
			say(gameforge.xxx_collect_quest_lv90._040_say)
			say("")
		end
		
		when __TARGET__.target.click or	20084.chat.gameforge.collect_quest_lv90._050_npcChat begin
			target.delete("__TARGET__")
			---                                                   l
			say(gameforge.xxx_collect_quest_lv90._050_say)
			say(gameforge.xxx_collect_quest_lv90._060_say)
			say(gameforge.xxx_collect_quest_lv90._070_say)
			say(gameforge.xxx_collect_quest_lv90._080_say)
			say(gameforge.xxx_collect_quest_lv90._090_say)
			say(gameforge.xxx_collect_quest_lv90._100_say)
			say(gameforge.xxx_collect_quest_lv90._110_say)
			say(gameforge.xxx_collect_quest_lv90._120_say)
			wait()
			say(gameforge.xxx_collect_quest_lv90._130_say)
			say(gameforge.xxx_collect_quest_lv90._140_say)
			say(gameforge.xxx_collect_quest_lv90._150_say)
			say(gameforge.xxx_collect_quest_lv90._160_say)
			say(gameforge.xxx_collect_quest_lv90._170_say)
			say(gameforge.xxx_collect_quest_lv90._180_say)
			say(gameforge.xxx_collect_quest_lv90._190_say)
			say(gameforge.xxx_collect_quest_lv90._200_say)
			say("")																																						  
			set_state(go_to_disciple)
			pc.setqf("duration",0)  -- 시도 할수 있는 시간
			pc.setqf("collect_count",0)--이제껏 모은 아이템 수
			pc.setqf("drink_drug",0) --현혹의 물약을 먹으면 1
		end
	end

	state go_to_disciple begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv90._210_sendLetter)
			
		end
		when button or info begin
			say_title(gameforge.xxx_collect_quest_lv90._220_sayTitle)
			---                                                   l
			say("")
			say(gameforge.xxx_collect_quest_lv90._230_say)
		    say(gameforge.xxx_collect_quest_lv90._240_say)
			say(gameforge.xxx_collect_quest_lv90._250_say)
			say(gameforge.xxx_collect_quest_lv90._260_say)
			say("")
			say_item_vnum(30168) 
			say_reward(string.format(gameforge.collect_quest_lv90._105_say_reward, pc.getqf("collect_count")))
			say("")
		end
		
		when 71035.use begin --현혹의 물약
			if get_time() < pc.getqf("duration") then
				say(gameforge.xxx_collect_quest_lv90._270_say)
				return
			end
			if pc.getqf("drink_drug")==1 then
				say(gameforge.xxx_collect_quest_lv90._280_say)
				return
			end
			if pc.count_item(30168)==0 then
				say(gameforge.xxx_collect_quest_lv90._050_say)
				say(gameforge.xxx_collect_quest_lv90._290_say)
				say(gameforge.xxx_collect_quest_lv90._300_say)
				say("")
				return
			end

			item.remove()	
			pc.setqf("drink_drug",1)
		end

		when 691.kill or 792.kill or 791.kill or 1093.kill or  1304.kill or 2091.kill or 2191.kill or 2206.kill or 1901.kill  begin
			local s = number(1, 100)
			if s <= 30 and pc.count_item(30168)==0 then
				pc.give_item2(30168, 1)
				send_letter(gameforge.xxx_collect_quest_lv90._310_sendLetter)
			end	
		end

		
    	when 20084.chat.gameforge.collect_quest_lv90._140_npcChat with pc.count_item(30168) >0   begin
			if get_time() > pc.getqf("duration") then
				say(gameforge.xxx_collect_quest_lv90._130_say)
				---                                                   l
				say(gameforge.xxx_collect_quest_lv90._320_say)
				say(gameforge.xxx_collect_quest_lv90._330_say)
				say(gameforge.xxx_collect_quest_lv90._340_say)
				say("")
				pc.remove_item(30168, 1)
				if  is_test_server()  then 
					pc.setqf("duration",get_time()+2) 
				else
					pc.setqf("duration",get_time()+60*60*22) -----------------------------------22시간
				end
				wait()
				
				local pass_percent
				if pc.getqf("drink_drug")==0 then
					pass_percent=60
				else		
					pass_percent=90
				end
				
				local s= number(1,100)
				if s<= pass_percent  then
				   if pc.getqf("collect_count")< 49 then     --50개미만 
						local index =pc.getqf("collect_count")+1 
						pc.setqf("collect_count",index)     --하나 구했으니 +1 해준다
						say(gameforge.xxx_collect_quest_lv90._050_say)
						say(gameforge.xxx_collect_quest_lv90._350_say)
						say(string.format(gameforge.collect_quest_lv90._165_say, 50-pc.getqf("collect_count")))
						say(gameforge.xxx_collect_quest_lv90._360_say)
						say("")
						pc.setqf("drink_drug",0)	 --물약 초기화
						return
					end
					say(gameforge.xxx_collect_quest_lv90._050_say)
					say(gameforge.xxx_collect_quest_lv90._370_say)
					say(gameforge.xxx_collect_quest_lv90._380_say)
					say(gameforge.xxx_collect_quest_lv90._390_say)
					say(gameforge.xxx_collect_quest_lv90._400_say)
					say(gameforge.xxx_collect_quest_lv90._410_say)
					say("")
					pc.setqf("collect_count",0)
					pc.setqf("drink_drug",0)	
					pc.setqf("duration",0) 
					set_state(key_item)
					return
				else								
				say(gameforge.xxx_collect_quest_lv90._050_say)
				say(gameforge.xxx_collect_quest_lv90._420_say)
				say(gameforge.xxx_collect_quest_lv90._430_say)
				say("")				   
				pc.setqf("drink_drug",0)	 --물약 초기화
				return
				end
		  else
		  say(gameforge.xxx_collect_quest_lv90._050_say)
		  say(gameforge.xxx_collect_quest_lv90._440_say)
		  say(gameforge.xxx_collect_quest_lv90._450_say)
		  say(gameforge.xxx_collect_quest_lv90._460_say)
		  say(gameforge.xxx_collect_quest_lv90._470_say)
		  say("")
		  return
		end

	end
end


	state key_item begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv90._210_sendLetter)
			
			if pc.count_item(30227)>0 then	
				local v = find_npc_by_vnum(20084)
				if v != 0 then
					target.vid("__TARGET__", v, gameforge.collect_quest_lv90._010_target)
				end
			end

		end
		when button or info begin
			if pc.count_item(30227) >0 then
				say_title(gameforge.xxx_collect_quest_lv90._480_sayTitle)
				say("")
				---                                                   l
				say(gameforge.xxx_collect_quest_lv90._490_say)
				say(gameforge.xxx_collect_quest_lv90._500_say)
				say("")
				return
			end

			say_title(gameforge.xxx_collect_quest_lv90._510_sayTitle)
			say("")
			---                                                   l
			say(gameforge.xxx_collect_quest_lv90._520_say)
			say(gameforge.xxx_collect_quest_lv90._530_say)
			say(gameforge.xxx_collect_quest_lv90._540_say)
			say_item_vnum(30227)----------패왕영혼석
			say(gameforge.collect_quest_lv90._240_say)
			say(string.format(gameforge.locale.list_two_comma, mob_name(1092), mob_name(1093)))
			say(string.format(gameforge.locale.list_two_period, mob_name(1304), mob_name(1901)))
			say("")
		end
		when 1093.kill or  1304.kill or 1901.kill  begin
			local s = number(1, 100)
			if s <= 30 and pc.count_item(30227)==0 then
				pc.give_item2(30227, 1)
				send_letter(gameforge.xxx_collect_quest_lv90._550_sendLetter)
			end	
		end



		
		when __TARGET__.target.click  or	20084.chat.gameforge.collect_quest_lv90._260_npcChat with pc.count_item(30227) > 0  begin
		    target.delete("__TARGET__")
			say(gameforge.xxx_collect_quest_lv90._130_say)
			say(gameforge.xxx_collect_quest_lv90._560_say)
			say(gameforge.xxx_collect_quest_lv90._570_say)
			say(gameforge.xxx_collect_quest_lv90._580_say)
			say(gameforge.xxx_collect_quest_lv90._590_say)
			say(gameforge.xxx_collect_quest_lv90._600_say)
			say(gameforge.xxx_collect_quest_lv90._610_say)
			say(gameforge.xxx_collect_quest_lv90._620_say)
			say(gameforge.xxx_collect_quest_lv90._630_say)
			say("")
			pc.remove_item(30227,1)
			set_state(__reward)
		end
		
	end
	
	state __reward begin
		when letter begin
			send_letter(gameforge.xxx_collect_quest_lv90._640_sendLetter)
			
			local v = find_npc_by_vnum(20018)
			if v != 0 then
				target.vid("__TARGET__", v, gameforge.collect_quest_lv90._280_target)
			end

		end
		when button or info begin
			say_title(gameforge.xxx_collect_quest_lv90._650_sayTitle)
			---                                                   l
			say(gameforge.xxx_collect_quest_lv90._660_say)
			say(gameforge.xxx_collect_quest_lv90._670_say)
			say(gameforge.xxx_collect_quest_lv90._680_say)
			say(gameforge.xxx_collect_quest_lv90._690_say)
			say(gameforge.xxx_collect_quest_lv90._700_say)
			say("")
		end
		
		when __TARGET__.target.click  or	20018.chat.gameforge.collect_quest_lv90._310_npcChat  begin
		    target.delete("__TARGET__")
			say(gameforge.xxx_collect_quest_lv90._710_say)
			say(gameforge.xxx_collect_quest_lv90._720_say)
			say(gameforge.xxx_collect_quest_lv90._730_say)
			say(gameforge.xxx_collect_quest_lv90._740_say)
			say(gameforge.xxx_collect_quest_lv90._750_say)
			say(gameforge.xxx_collect_quest_lv90._760_say)
			say(gameforge.xxx_collect_quest_lv90._770_say)
			say(gameforge.xxx_collect_quest_lv90._780_say)
			say(gameforge.xxx_collect_quest_lv90._790_say)
			say("")
			wait()
			say(gameforge.xxx_collect_quest_lv90._710_say)
			say(gameforge.xxx_collect_quest_lv90._800_say)
			say(gameforge.xxx_collect_quest_lv90._810_say)
			say("")
			say_reward(gameforge.collect_quest_lv90._317_say_reward)
			say_reward(gameforge.collect_quest_lv90._318_say_reward)
			say_reward(gameforge.collect_quest_lv90._319_say_reward)
			affect.add_collect_point(POINT_ATTBONUS_WARRIOR,8,60*60*24*365*60)	
			affect.add_collect_point(POINT_ATTBONUS_ASSASSIN,8,60*60*24*365*60) 	
			affect.add_collect_point(POINT_ATTBONUS_SURA,8,60*60*24*365*60) 	
			affect.add_collect_point(POINT_ATTBONUS_SHAMAN,8,60*60*24*365*60) 	
			pc.give_item2(50114)
			clear_letter()
			set_quest_state("collect_quest_lv92", "run")
			set_state(__complete)
		end
			
	end

	
	state __complete begin
	end
end


